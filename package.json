{
  "name": "@douglasneuroinformatics/libpasswd",
  "type": "module",
  "version": "0.0.3",
  "packageManager": "pnpm@11.8.0",
  "description": "A library for estimating the strength of passwords",
  "author": "Joshua Unrau",
  "license": "Apache-2.0",
  "homepage": "https://github.com/DouglasNeuroInformatics/libpasswd#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/DouglasNeuroInformatics/libpasswd.git"
  },
  "bugs": {
    "url": "https://github.com/DouglasNeuroInformatics/libpasswd/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "!/dist/**/*.spec.*",
    "!/dist/**/*.test.*",
    "!/src/**/*.spec.*",
    "!/src/**/*.test.*",
    "/dist",
    "/src"
  ],
  "scripts": {
    "build": "tsc",
    "build:docs": "typedoc",
    "format": "prettier --write src",
    "lint": "tsc --noEmit && eslint --fix src",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "@zxcvbn-ts/language-fr": "^3.0.2",
    "type-fest": "^6.0.1"
  },
  "devDependencies": {
    "@douglasneuroinformatics/eslint-config": "^6.0.0",
    "@douglasneuroinformatics/prettier-config": "^0.4.0",
    "@douglasneuroinformatics/semantic-release": "^0.2.2",
    "@douglasneuroinformatics/tsconfig": "^2.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "9.39.x",
    "husky": "^9.1.6",
    "prettier": "^3.10.0",
    "typedoc": "^0.28.20",
    "typescript": "6.0.x",
    "vitest": "^5.1.0"
  },
  "commitlint": {
    "extends": [
      "@douglasneuroinformatics/semantic-release/commitlint-config"
    ]
  },
  "prettier": "@douglasneuroinformatics/prettier-config",
  "release": {
    "extends": [
      "@douglasneuroinformatics/semantic-release"
    ]
  }
}
